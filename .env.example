# ScoutBox environment settings
# Copy this file to .env before running initial_setup_macos.sh or initial_setup_ubuntu.sh.
# The defaults below are enough for a first run; API keys and mail settings can be
# entered later in the portal (Configuration > Search Sources, AI & Discovery, Email).

# --- Django ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_PORT=8989
PORTAL_ROOT_URL=http://localhost:8989
TIME_ZONE=Asia/Singapore

# --- Database (PostgreSQL container) -----------------------------------------
POSTGRES_DB=scoutbox
POSTGRES_USER=scoutbox
POSTGRES_PASSWORD=scoutbox
DATABASE_URL=postgres://scoutbox:scoutbox@db:5432/scoutbox

# --- Queue (Redis container) --------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=4

# --- Local AI (Ollama) --------------------------------------------------------
# macOS: Ollama runs on the host and is reached through host.docker.internal.
# Ubuntu + NVIDIA: the Compose overlay starts an ollama container; use http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=gemma3:4b
LOCAL_AI_REQUEST_TIMEOUT_SECONDS=180

# --- Cloud AI (optional; leave blank to use local models only) ----------------
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUD_AI_REQUEST_TIMEOUT_SECONDS=90
# Daily caps for cloud usage
CLOUD_DAILY_REQUESTS=400
CLOUD_DAILY_WEB_SEARCHES=100

# --- SearchApi (optional; can also be entered in the portal) -----------------
SEARCHAPI_API_KEY=
SEARCHAPI_DAILY_LIMIT=1000

# --- Search behaviour ---------------------------------------------------------
PROVIDER_DAILY_REQUEST_BUDGET=5000
MAX_RESULTS_PER_QUERY=10
QUERIES_PER_PROVIDER=6
SCRAPER_INTERVAL_MINUTES=60
MAX_CONCURRENT_CAMPAIGNS=3
FETCH_TIMEOUT_SECONDS=25
USER_AGENT=ScoutBox/0.11 (+http://localhost:8989)

# --- Mail (optional; used for drafts, digests and notifications) -------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Alternative outgoing method
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=scoutbox@example.com
DIGEST_RECIPIENT_EMAIL=

# --- Storage and retention ----------------------------------------------------
MEDIA_ROOT=/data/media
DETAILED_LOG_RETENTION_DAYS=30
RESOURCE_SAMPLE_INTERVAL_SECONDS=30

# --- Feature flags ------------------------------------------------------------
FEATURE_PAGE_FETCH=true
FEATURE_COMPANY_ENRICHMENT=true
FEATURE_AGE_ESTIMATION=true
FEATURE_CONTACT_DISCOVERY=true
FEATURE_FACEBOOK_INDEX_SEARCH=false
FEATURE_DOCUMENT_CONVERSION=true
